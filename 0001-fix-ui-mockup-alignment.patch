diff --git a/app/Http/Controllers/CatalogController.php b/app/Http/Controllers/CatalogController.php
index 1d0910d..1f32c02 100644
--- a/app/Http/Controllers/CatalogController.php
+++ b/app/Http/Controllers/CatalogController.php
@@ -2,6 +2,7 @@
 
 namespace App\Http\Controllers;
 
+use App\Models\Author;
 use App\Models\Book;
 use App\Models\Category;
 use App\Models\DdcClass;
@@ -18,6 +19,7 @@ public function index(Request $request): Response
         $categorySlug = $request->input('category');
         $ddcCode = $request->input('ddc');
         $status = $request->input('status', 'all');
+        $author = $request->input('author');
         $sort = $request->input('sort', 'popular');
 
         $query = Book::with(['category', 'authors', 'copies', 'ddcClass']);
@@ -32,6 +34,12 @@ public function index(Request $request): Response
             });
         }
 
+        if ($author) {
+            $query->whereHas('authors', function (Builder $q) use ($author) {
+                $q->where('name', $author);
+            });
+        }
+
         if ($ddcCode) {
             $query->whereHas('ddcClass', function (Builder $q) use ($ddcCode) {
                 $q->where('code', $ddcCode);
@@ -56,16 +64,19 @@ public function index(Request $request): Response
         $books = $query->paginate(12)->withQueryString();
         $categories = Category::withCount('books')->orderBy('name')->get();
         $ddcClasses = DdcClass::orderBy('code')->get();
+        $authors = Author::orderBy('name')->pluck('name');
 
         return Inertia::render('Catalog/Index', [
             'books' => $books,
             'categories' => $categories,
             'ddcClasses' => $ddcClasses,
+            'authors' => $authors,
             'filters' => [
                 'q' => $search ?? '',
                 'category' => $categorySlug ?? '',
                 'ddc' => $ddcCode ?? '',
                 'status' => $status,
+                'author' => $author ?? '',
                 'sort' => $sort,
             ],
         ]);
